{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lifeline-care-supply",
  "main": "src/index.js",
  "compatibility_date": "2026-11-23",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lifeline-care-supply-db",
      "database_id": "21ac5965-ccf1-4f98-b808-469a93cb18bc"
    }
  ],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  "triggers": {
    "crons": [
      "*/5 * * * *",
      "0 21 * * *"
    ]
  }
}
